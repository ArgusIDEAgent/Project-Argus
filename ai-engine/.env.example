# CodeMind environment reference. All normal application settings are optional.
# Copy to ai-engine/.env for Python engine entry points; do not commit .env.
# python-dotenv preserves already exported values. VS Code does not read this
# file: export matching port/data/token values in the environment launching it.
# Standalone knowledge_base CLIs read process environment directly.
# Commented examples do nothing. Empty strings are not universally defaults.

# --- Backend and storage ---
# CODEMIND_DATA_DIR: optional; default ~/.codemind/data (config.py, scanner.py,
# metadata.py). Private indexes, models, registry and session token live here.
# Use a private absolute path consistently for engine and extension. Python
# resolves a relative path from its cwd; the extension uses path.resolve().
# Do not set an empty value: Python and the extension treat it differently.
# Example: CODEMIND_DATA_DIR=/absolute/private/path/codemind/data
# CODEMIND_DATA_DIR=~/.codemind/data

# CODEMIND_PORT: optional; engine and extension default 8000, loopback only.
# Use the same positive integer port for both. Python int() rejects empty or
# invalid text; extension parseInt(..., 10) || 8000 falls back for empty/zero.
# Example/default:
# CODEMIND_PORT=8000

# --- Local model ---
# CODEMIND_LOCAL_MODEL: optional; default llama3:latest (answers.py,
# hybrid_api.py, query_system/local_ollama.py). Select an installed local Ollama
# model at fixed 127.0.0.1:11434; this is unrelated to CODEMIND_LLM_MODEL.
# An explicitly empty value disables generation and retains evidence fallback.
# No automatic model pull or remote provider is enabled by this example.
# Example/default: CODEMIND_LOCAL_MODEL=llama3:latest
# Disable local answer generation: CODEMIND_LOCAL_MODEL=

# --- Hybrid query system ---
# CODEMIND_ENABLE_HYBRID: optional; default "0" (disabled). Only "1" or "true"
# (case-insensitive, no whitespace trimming) enables the backend hybrid routes.
# The VS Code codemind.hybridEnabled setting is a separate, default-off gate.
CODEMIND_ENABLE_HYBRID=0

# --- Synchronization ---
# CODEMIND_AUTO_SYNC: optional; default "1" (enabled). Only the exact string
# "0" disables the API's watcher manager; "false" does not disable it.
# Example/default: CODEMIND_AUTO_SYNC=1
# Disable watching: CODEMIND_AUTO_SYNC=0

# --- Session/security ---
# CODEMIND_SESSION_TOKEN: optional; no fixed default. Unset, empty or whitespace
# generates secrets.token_hex(32) on engine startup; the token is stored in
# CODEMIND_DATA_DIR/session_token with mode 0600. The extension reads that file
# unless it receives an explicit token. Treat it as a credential; never log it.
# Prefer automatic generation. If overridden, supply the same private value to
# both processes. Example safe value: empty (automatic generation).
CODEMIND_SESSION_TOKEN=

# --- Vector storage ---
# QDRANT_URL: optional; no URL default. Unset/empty uses private local FAISS.
# A nonempty URL explicitly selects Qdrant compatibility storage and may send
# indexed source/embeddings to that server. Set it only for an intended trusted
# server. Safe example: empty (local FAISS); optional local URL:
# QDRANT_URL=http://127.0.0.1:6333
QDRANT_URL=

# QDRANT_API_KEY: optional; default None (unset/empty). Used only when QDRANT_URL
# selects Qdrant; required only if that server requires authentication. Never
# commit a real key; protect it and use TLS for non-loopback deployments.
# Safe example: empty (no key, no remote storage).
QDRANT_API_KEY=

# --- Legacy/optional integrations ---
# OPENROUTER_API_KEY: optional for local-first CodeMind, no default. Required
# only for intentional legacy OpenRouter requests. Empty keeps it unconfigured.
# Never commit a real key. The manual utility also requires
# --allow-external-llm; providing a key alone cannot authorize that utility.
OPENROUTER_API_KEY=

# CODEMIND_LLM_MODEL: optional; actual legacy rag_pipeline.py default is
# openrouter/cohere/north-mini-code:free. This does NOT select the local Ollama
# model used by current /ask or hybrid chat. The legacy RAG CLI itself retains
# its historical provider behavior and is not an automated test command.
# Do not run it with source context unless that external access is authorized.
# Historical default/example (inactive):
# CODEMIND_LLM_MODEL=openrouter/cohere/north-mini-code:free

# ARGUS_DEMO_JWT_SECRET: sample_code/auth_service.py only, not an engine setting.
# Unset/empty default; >=32 characters required if intentionally running the
# demo JWT functions. PyJWT is a demo-only dependency, not added by this phase.
# Example shape only; generate a private value instead of using this placeholder:
# ARGUS_DEMO_JWT_SECRET=replace-with-a-private-random-value-at-least-32-characters

# ARGUS_DEMO_ADMIN_HASH: sample fixture only; default empty rejects demo login.
# Optional generally, required for successful demo admin login; protect it.
# Example safe value (demo login remains disabled): ARGUS_DEMO_ADMIN_HASH=

# --- Test/qualification tools only (not application startup settings) ---
# CODEMIND_TEST_VSCODE: optional (extension/test/runTest.js). No environment
# default; runner uses installed /Applications/Visual Studio Code.app if present,
# otherwise the runner refuses with a not-executed error. It never downloads a
# runtime automatically. Example:
# CODEMIND_TEST_VSCODE=/Applications/Visual Studio Code.app/Contents/MacOS/Code

# CODEMIND_QUAL_REPO_ROOT: optional generally, required to opt into the separate
# real-source stabilization host fixture. No default; absent skips that suite.
# Only point at an isolated, already indexed qualification fixture, never an
# ordinary user repo. Example: CODEMIND_QUAL_REPO_ROOT=/tmp/private-fixture/repo

# CODEMIND_QUAL_MODEL_CACHE: optional for that fixture; default
# CODEMIND_DATA_DIR/models. Cached local embeddings only; no model download.
# Example: CODEMIND_QUAL_MODEL_CACHE=/absolute/private/model-cache

# LITELLM_LOCAL_MODEL_COST_MAP: LiteLLM library option, not a CodeMind setting.
# pytest forces True to prevent import-time provider-price metadata downloads.
# Use True for documented engine unittest runs too; normal startup is unchanged.
# Example: LITELLM_LOCAL_MODEL_COST_MAP=True
