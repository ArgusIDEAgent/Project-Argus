{
  "name": "codemind-extension",
  "displayName": "CodeMind",
  "publisher": "codemind-local",
  "description": "Evidence-backed VS Code Assistant",
  "version": "0.4.1",
  "private": true,
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Chat is available. Repository scanning requires Workspace Trust."
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:codemind.previewResponse",
    "onStartupFinished",
    "onCommand:codemind.openChat",
    "onCommand:codemind.checkConnection",
    "onCommand:codemind.selectRepository",
    "onCommand:codemind.openDocsOverview",
    "onCommand:codemind.syncDocs"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codemind.previewResponse",
        "title": "CodeMind: Preview Validated Response (Phase 9)"
      },
      {
        "command": "codemind.openChat",
        "title": "CodeMind: Open Chat"
      },
      {
        "command": "codemind.checkConnection",
        "title": "CodeMind: Check Connection"
      },
      {
        "command": "codemind.selectRepository",
        "title": "CodeMind: Select Repository"
      },
      {
        "command": "codemind.searchCode",
        "title": "CodeMind: Search Code"
      },
      {
        "command": "codemind.checkReuse",
        "title": "CodeMind: Check for Reusable Code"
      },
      {
        "command": "codemind.openDocsOverview",
        "title": "CodeMind: Open Documentation Overview"
      },
      {
        "command": "codemind.syncDocs",
        "title": "CodeMind: Sync Documentation"
      }
    ],
    "configuration": {
      "title": "CodeMind",
      "properties": {
        "codemind.hybridEnabled": {
          "type": "boolean", "default": false,
          "description": "Opt into the development hybrid chat pipeline. Requires CODEMIND_ENABLE_HYBRID=1 on the local engine. Turn off to restore legacy chat."
        },
        "codemind.hybridDepth": {
          "type": "string", "enum": ["quick", "standard", "deep"], "default": "standard",
          "description": "Presentation depth for opt-in hybrid chat; depth changes do not invoke new retrieval or generation."
        },
        "codemind.hybridAllowGeneration": {
          "type": "boolean", "default": true,
          "description": "Allow grounded local Ollama explanations in opt-in hybrid mode; deterministic questions never invoke it."
        },
        "codemind.checkReuseOnSave": {
          "type": "boolean", "default": true,
          "description": "Check newly indexed symbols for reusable implementations after saving."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:integration": "npm run compile && node test/runTest.js",
    "package:vsix": "vsce package --out ../codemind-extension-0.4.1.vsix"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
